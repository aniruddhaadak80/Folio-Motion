# ==============================================================================
# SMTP Email Configuration (Nodemailer)
# ==============================================================================
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security).
# 2. Generate a 16-character App Password at: myaccount.google.com/apppasswords
# 3. Paste your email in SMTP_USER and the 16-character password into SMTP_PASS.
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ssubratkumar106@gmail.com
SMTP_PASS=your_16_character_google_app_password
CONTACT_RECEIVER_EMAIL=ssubratkumar106@gmail.com
